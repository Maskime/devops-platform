<!doctype html>
<!--
  Page d'accueil de la plateforme, servie par le service home (compose/tools.yml).
  Modèle rendu au démarrage du conteneur par l'image nginx (envsubst) : les variables ${…} sont les
  hostnames de l'instance, transmis par compose. Liens sans schéma (//hôte/) : ils reprennent celui
  de la page, identique pour tous les services (TLS_MODE commun à l'instance) ; les URLs MCP affichées
  le reçoivent du script en fin de page. Serveur MCP SonarQube : SONARQUBE_MCP_ACTIF (1 ou 0), calculé
  par scripts/instance.sh (docs/mcp.md).
-->
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Plateforme DevOps</title>
  <style>
    :root {
      --fond: #f6f7f9; --carte: #ffffff; --texte: #1d2330; --doux: #5b6475;
      --bord: #dde1e8; --accent: #2f5bd3;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --fond: #14171d; --carte: #1c2029; --texte: #e6e9ef; --doux: #9aa3b5;
        --bord: #2c323e; --accent: #7fa2ff;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--fond); color: var(--texte);
      font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    main { max-width: 960px; margin: 0 auto; padding: 48px 16px; }
    h1 { margin: 0 0 4px; font-size: 1.75rem; }
    header p { margin: 0 0 32px; color: var(--doux); }
    ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
    a.carte {
      display: block; height: 100%; padding: 20px; border: 1px solid var(--bord); border-radius: 10px;
      background: var(--carte); color: inherit; text-decoration: none;
    }
    a.carte:hover, a.carte:focus-visible { border-color: var(--accent); outline: none; }
    a.carte strong { display: block; font-size: 1.125rem; color: var(--accent); }
    a.carte span { display: block; color: var(--doux); font-size: 0.9375rem; }
    a.carte code { font-size: 0.8125rem; color: var(--doux); word-break: break-all; }
    h2 { margin: 40px 0 4px; font-size: 1.25rem; }
    section > p { margin: 0 0 16px; color: var(--doux); }
    div.carte { padding: 20px; border: 1px solid var(--bord); border-radius: 10px; background: var(--carte); }
    div.carte strong { display: block; font-size: 1.125rem; }
    div.carte span { display: block; color: var(--doux); font-size: 0.9375rem; }
    div.carte code { display: block; margin-top: 8px; font-size: 0.8125rem; word-break: break-all; }
    [hidden] { display: none !important; }
  </style>
</head>
<body>
  <main>
    <header>
      <h1>Plateforme DevOps</h1>
      <p>Accès aux services de l'instance.</p>
    </header>
    <ul>
      <li><a class="carte" href="//${GITLAB_HOSTNAME}/">
        <strong>GitLab</strong>
        <span>Forge, tickets, CI/CD. Clone SSH sur le port ${GITLAB_SSH_PORT}.</span>
        <code>${GITLAB_HOSTNAME}</code></a></li>
      <li><a class="carte" href="//${SONARQUBE_HOSTNAME}/">
        <strong>SonarQube</strong>
        <span>Analyse statique et qualité du code.</span>
        <code>${SONARQUBE_HOSTNAME}</code></a></li>
      <li><a class="carte" href="//${GRAFANA_HOSTNAME}/">
        <strong>Grafana</strong>
        <span>Logs de la plateforme (Loki).</span>
        <code>${GRAFANA_HOSTNAME}</code></a></li>
      <li><a class="carte" href="//${PORTAINER_HOSTNAME}/">
        <strong>Portainer</strong>
        <span>Gestion des conteneurs.</span>
        <code>${PORTAINER_HOSTNAME}</code></a></li>
      <li><a class="carte" href="//${PLANTUML_HOSTNAME}/">
        <strong>PlantUML</strong>
        <span>Génération de diagrammes.</span>
        <code>${PLANTUML_HOSTNAME}</code></a></li>
    </ul>
    <section>
      <h2>Serveurs MCP</h2>
      <p>Pour brancher un agent IA (Claude Code…) sur l'instance : voir docs/mcp.md du dépôt.</p>
      <ul>
        <li><div class="carte">
          <strong>GitLab</strong>
          <span>Serveur intégré à GitLab. Authentification OAuth dans le navigateur, HTTPS obligatoire.</span>
          <code data-url="//${GITLAB_HOSTNAME}/api/v4/mcp">${GITLAB_HOSTNAME}/api/v4/mcp</code>
          <code data-commande="gitlab" data-url="//${GITLAB_HOSTNAME}/api/v4/mcp"></code></div></li>
        <li><div class="carte" data-mcp-sonarqube="${SONARQUBE_MCP_ACTIF}">
          <strong>SonarQube</strong>
          <span class="actif">Authentification par jeton utilisateur SonarQube (en-tête Authorization: Bearer).</span>
          <span class="inactif">Désactivé sur cette instance (SONARQUBE_MCP_ENABLED).</span>
          <code class="actif" data-url="//${SONARQUBE_MCP_HOSTNAME}/mcp">${SONARQUBE_MCP_HOSTNAME}/mcp</code>
          <code class="actif" data-commande="sonarqube" data-url="//${SONARQUBE_MCP_HOSTNAME}/mcp"
            data-entete="Authorization: Bearer &lt;jeton&gt;"></code></div></li>
      </ul>
    </section>
  </main>
  <script>
    // URLs complètes avec le schéma de la page (http ou https selon le TLS_MODE de l'instance)
    document.querySelectorAll("code[data-url]").forEach(function (e) {
      var url = location.protocol + e.dataset.url;
      if (!e.dataset.commande) { e.textContent = url; return; }
      e.textContent = "claude mcp add --transport http " + e.dataset.commande + " " + url +
        (e.dataset.entete ? ' --header "' + e.dataset.entete + '"' : "");
    });
    // Carte SonarQube : contenu selon l'activation du serveur MCP
    document.querySelectorAll("[data-mcp-sonarqube]").forEach(function (c) {
      var actif = c.dataset.mcpSonarqube === "1";
      c.querySelectorAll(".actif").forEach(function (e) { e.hidden = !actif; });
      c.querySelectorAll(".inactif").forEach(function (e) { e.hidden = actif; });
    });
  </script>
</body>
</html>
