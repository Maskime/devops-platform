# =============================================================================
# Profil de dimensionnement « small » — petit serveur ou poste de développement (mémoire contrainte)
#
# Sélectionné par PLATFORM_PROFILE=small dans envs/<env>.env (voir docs/dimensionnement.md).
# Fichier de la plateforme, versionné et sans secret : ce n'est PAS un fichier d'instance.
# Injecté par env_file dans les conteneurs gitlab (lu par GITLAB_OMNIBUS_CONFIG) et sonarqube.
# Tous les profils doivent définir exactement les mêmes clés (contrôlé par make verify).
#
# Ressources minimales de l'hôte (plateforme complète, hors jobs CI du runner) : 8 Go de RAM, 4 vCPU, 50 Go de disque.
#
# PostgreSQL GitLab : max_connections ≥ 2 bases (main, ci) × [workers Puma (1 en mode single)
#   × (max_threads + 10) + (concurrence Sidekiq + 10)], plus une marge (exporters, tâches rake).
# =============================================================================

# --- GitLab : Puma (0 = mode single, sans processus maître) ------------------
PROFILE_GITLAB_PUMA_WORKERS=0
PROFILE_GITLAB_PUMA_MIN_THREADS=1
PROFILE_GITLAB_PUMA_MAX_THREADS=4

# --- GitLab : Sidekiq --------------------------------------------------------
PROFILE_GITLAB_SIDEKIQ_CONCURRENCY=5

# --- GitLab : PostgreSQL embarqué --------------------------------------------
PROFILE_GITLAB_PG_SHARED_BUFFERS=128MB
PROFILE_GITLAB_PG_MAX_CONNECTIONS=100

# --- SonarQube : heaps JVM (remplacent les valeurs par défaut de l'image) ----
# Elasticsearch (search) : Xms = Xmx obligatoire.
SONAR_WEB_JAVAOPTS=-Xmx512m -Xms128m -XX:+HeapDumpOnOutOfMemoryError
SONAR_CE_JAVAOPTS=-Xmx512m -Xms128m -XX:+HeapDumpOnOutOfMemoryError
SONAR_SEARCH_JAVAOPTS=-Xmx512m -Xms512m -XX:MaxDirectMemorySize=256m -XX:+HeapDumpOnOutOfMemoryError
