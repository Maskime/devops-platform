# =============================================================================
# Exemple de fichier d'environnement d'une instance
# Copier en envs/<env>.env et remplacer chaque valeur change_me_*.
# Version minimale : la documentation exhaustive des variables relève de l'US 2-1.
# =============================================================================

# --- GitLab CE ---------------------------------------------------------------
# URL d'accès à GitLab (ex : http://localhost ou https://gitlab.example.com)
GITLAB_EXTERNAL_URL=http://localhost
# Mot de passe root initial — 8 caractères minimum, sans guillemet simple
GITLAB_ROOT_PASSWORD=change_me_gitlab_root_password

# --- SonarQube ---------------------------------------------------------------
# Mot de passe PostgreSQL de la base SonarQube (usage interne inter-conteneurs)
SONARQUBE_DB_PASSWORD=change_me_sonarqube_db_password

# --- Observabilité (Grafana) -------------------------------------------------
# Port hôte de l'UI Grafana (défaut : 3100)
GRAFANA_PORT=3100
# Identifiants administrateur Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# --- Outils (PlantUML) -------------------------------------------------------
# Port hôte du serveur PlantUML (défaut : 8081)
PLANTUML_PORT=8081
