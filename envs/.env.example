# =============================================================================
# Fichier d'environnement d'une instance — modèle documenté
#
# Recommandé : make init ENV=<env> génère envs/<env>.env à partir de ce modèle (questions,
# secrets aléatoires). Sinon : copier en envs/<env>.env et remplacer chaque valeur change_me_*.
# Puis : make deploy ENV=<env>
#
# Chaque variable est précédée de son rôle et de la mention :
#   [obligatoire]                — sans valeur, make et docker compose refusent de démarrer ;
#   [optionnel — défaut : X]     — ligne commentée : décommenter pour changer la valeur.
#
# Règles de format (lu par docker compose ET par les scripts) :
#   - une affectation VAR=valeur par ligne, commentaires uniquement sur des lignes à part
#     (jamais « VAR=valeur # commentaire ») ;
#   - pas d'espace autour du « = » ; guillemets englobants facultatifs.
#
# À savoir :
#   - une seule instance par hôte : le nom de projet compose (devops-platform) est fixe ;
#     ne pas définir COMPOSE_PROJECT_NAME ici (il casserait volumes et collecte des logs) ;
#   - une variable exportée dans le shell est prioritaire sur ce fichier.
#   - chaque *_VERSION épingle un tag versionné (jamais latest) ; changer de version :
#     docs/montee-de-version.md.
# =============================================================================

# --- Plateforme --------------------------------------------------------------

# Nom du réseau Docker partagé par tous les services (et par les jobs CI du runner).
# [optionnel — défaut : devops-platform]
#PLATFORM_NETWORK=devops-platform

# Profil de dimensionnement de GitLab (Puma, Sidekiq, PostgreSQL embarqué) et de SonarQube
# (heaps JVM) : un nom de fichier de config/profiles/, sans l'extension. Ressources minimales
# de l'hôte (plateforme complète, hors jobs CI) :
#   small  :  8 Go de RAM,  4 vCPU,  50 Go de disque
#   medium : 16 Go de RAM,  8 vCPU, 100 Go de disque
#   large  : 32 Go de RAM, 16 vCPU, 250 Go de disque
# Détail des réglages : README, section « Profils de dimensionnement ».
# [optionnel — défaut : medium]
#PLATFORM_PROFILE=medium

# Socket Docker de l'hôte, monté dans gitlab-runner, promtail et portainer
# (à changer pour Docker rootless, ex : /run/user/1000/docker.sock).
# [optionnel — défaut : /var/run/docker.sock]
#DOCKER_SOCKET=/var/run/docker.sock

# --- Exposition (reverse proxy Traefik, TLS) --------------------------------

# Mode TLS de l'instance : letsencrypt (certificats Let's Encrypt automatiques), custom
# (certificats fournis dans config/certs/) ou none (HTTP simple, usage local). Vide = none.
# none : services en HTTP sur le port 80, *_EXTERNAL_URL en http:// exigées ; make deploy avertit
# si un hostname n'est pas local (localhost, *.localhost). TLS terminé en amont (load balancer) :
# non géré.
# custom : HTTPS sur le port 443 (80 redirigé), certificat lu dans config/certs/cert.pem (chaîne
# complète) et config/certs/key.pem (non chiffrée), couvrant chaque *_HOSTNAME ; *_EXTERNAL_URL en
# https:// exigées, SONARQUBE_ et GRAFANA_EXTERNAL_URL comprises. Contrôlé par make deploy ;
# renouvellement : make reload-certs. Voir docs/certificats.md.
# letsencrypt : HTTPS sur le port 443 (80 redirigé), certificats Let's Encrypt obtenus et
# renouvelés par Traefik ; chaque *_HOSTNAME doit être un nom public résolu vers le serveur (ni
# localhost, ni IP), ACME_EMAIL est obligatoire ; *_EXTERNAL_URL en https:// exigées, SONARQUBE_ et
# GRAFANA_EXTERNAL_URL comprises. Contrôlé par make deploy. Voir docs/certificats.md.
# [optionnel — défaut : none]
#TLS_MODE=none

# Email du compte Let's Encrypt (TLS_MODE=letsencrypt) : adresse réelle, les domaines d'exemple
# (example.com…) sont refusés par Let's Encrypt.
# [obligatoire en TLS_MODE=letsencrypt]
#ACME_EMAIL=ops@mondomaine.fr

# Challenge ACME (TLS_MODE=letsencrypt) : http (HTTP-01, port 80 joignable depuis Internet) ou
# tls (TLS-ALPN-01, port 443 seul). DNS-01 non géré (#75).
# [optionnel — défaut : http]
#ACME_CHALLENGE=http

# Annuaire ACME (TLS_MODE=letsencrypt). Pour des essais sans consommer les limites de production :
# https://acme-staging-v02.api.letsencrypt.org/directory (certificats non reconnus par les
# navigateurs ; revenir en production : docs/certificats.md).
# [optionnel — défaut : https://acme-v02.api.letsencrypt.org/directory]
#ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Hostname de chaque service web : Traefik route les requêtes (port 80, et 443 en HTTPS) selon ce
# nom (aucun autre port web n'est publié). Chaque nom doit résoudre vers le serveur (DNS). make init propose
# <service>.<domaine>.
# En local, *.localhost est résolu vers 127.0.0.1 par les navigateurs et curl seulement ; pour les
# autres outils (git, wget…), ajouter à /etc/hosts :
#   127.0.0.1 gitlab.localhost sonarqube.localhost grafana.localhost portainer.localhost plantuml.localhost
# [optionnel — défaut : <service>.localhost]
#GITLAB_HOSTNAME=gitlab.localhost
#SONARQUBE_HOSTNAME=sonarqube.localhost
#GRAFANA_HOSTNAME=grafana.localhost
#PORTAINER_HOSTNAME=portainer.localhost
#PLANTUML_HOSTNAME=plantuml.localhost

# Tag de l'image traefik.
# [optionnel — défaut : v3.7.13]
#TRAEFIK_VERSION=v3.7.13

# --- GitLab CE + Runner ------------------------------------------------------

# URL publique de GitLab : liens, URLs de clone HTTP, appels API des scripts.
# Son hôte doit être GITLAB_HOSTNAME, sans port (contrôlé par make) ; http:// exigé en
# TLS_MODE=none, https:// en custom et letsencrypt.
# [obligatoire]
GITLAB_EXTERNAL_URL=http://gitlab.localhost

# Mot de passe root, appliqué au premier démarrage seulement — 8 caractères minimum,
# sans guillemet simple.
# [obligatoire]
GITLAB_ROOT_PASSWORD=change_me_gitlab_root_password

# Port SSH publié sur l'hôte (aussi affiché dans les URLs de clone SSH).
# [optionnel — défaut : 2222]
#GITLAB_SSH_PORT=2222

# Tag de l'image gitlab/gitlab-ce. Respecter le chemin de mise à jour GitLab
# (docs/montee-de-version.md).
# [optionnel — défaut : 19.4.1-ce.0]
#GITLAB_VERSION=19.4.1-ce.0

# Tag de l'image gitlab/gitlab-runner (même version majeure.mineure que GitLab, montée après lui).
# [optionnel — défaut : v19.4.1]
#GITLAB_RUNNER_VERSION=v19.4.1

# --- SonarQube ---------------------------------------------------------------

# Mot de passe PostgreSQL de la base SonarQube (usage interne inter-conteneurs).
# [obligatoire]
SONARQUBE_DB_PASSWORD=change_me_sonarqube_db_password

# Mot de passe du compte admin, positionné par le bootstrap — 12 caractères minimum,
# avec au moins une majuscule, une minuscule, un chiffre et un caractère spécial.
# [obligatoire pour le bootstrap]
SONARQUBE_ADMIN_PASSWORD=change_me_sonarqube_admin_password

# URL publique de SonarQube (sonar.core.serverBaseURL : liens, décoration des merge requests ;
# utilisée aussi par les scripts). Son hôte doit être SONARQUBE_HOSTNAME, sans port ; http://
# exigé en TLS_MODE=none ; en custom et letsencrypt, à définir en https:// (le défaut est en http://).
# [optionnel — défaut : http://${SONARQUBE_HOSTNAME}]
#SONARQUBE_EXTERNAL_URL=http://sonarqube.localhost

# Tag de l'image mc1arke/sonarqube-with-community-branch-plugin (SonarQube + plugin
# community branch : la version est bornée par le plugin). Migration de schéma et renouvellement
# du volume des plugins à chaque montée : voir docs/montee-de-version.md.
# [optionnel — défaut : 26.5.0.122743-community]
#SONARQUBE_VERSION=26.5.0.122743-community

# Tag de l'image postgres de la base SonarQube (version supportée par SonarQube).
# Changement de version majeure : dump et restauration (docs/montee-de-version.md).
# [optionnel — défaut : 17.11]
#SONARQUBE_DB_VERSION=17.11

# --- Observabilité (Grafana, Loki, Promtail) ---------------------------------

# Identifiant administrateur Grafana.
# [optionnel — défaut : admin]
#GRAFANA_ADMIN_USER=admin

# Mot de passe administrateur Grafana.
# [obligatoire]
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# URL publique de Grafana (root_url : liens et redirections). Son hôte doit être
# GRAFANA_HOSTNAME, sans port ; http:// exigé en TLS_MODE=none ;
# en custom et letsencrypt, à définir en https:// (le défaut est en http://).
# [optionnel — défaut : http://${GRAFANA_HOSTNAME}]
#GRAFANA_EXTERNAL_URL=http://grafana.localhost

# Tag de l'image grafana/grafana.
# [optionnel — défaut : 13.2.3]
#GRAFANA_VERSION=13.2.3

# Tag de l'image grafana/loki.
# [optionnel — défaut : 3.7.8]
#LOKI_VERSION=3.7.8

# Durée de conservation des logs dans Loki : le compacteur purge les logs plus anciens.
# Unités h, d, w (744h, 31d, 4w…) ; minimum 24h, multiple de 24h recommandé, au moins 168h
# recommandé (Loki accepte à l'ingestion les logs de moins de 7 jours) ; 0s = conservation illimitée
# (le volume loki_data croît sans limite). Purge effective de l'ordre de 4h après l'échéance
# (README, « Rétention des logs (Loki) »).
# [optionnel — défaut : 744h (31 jours)]
#LOKI_RETENTION_PERIOD=744h

# Tag de l'image grafana/promtail.
# [optionnel — défaut : 3.6.11]
#PROMTAIL_VERSION=3.6.11

# --- Outils (Portainer, PlantUML) --------------------------------------------

# Mot de passe du compte admin Portainer, créé au premier démarrage seulement (sans effet sur une
# instance déjà initialisée : le changer ensuite dans l'interface) — 12 caractères minimum
# (contrôlé par make). Transmis par un secret Compose, jamais affiché par `docker compose config`.
# [obligatoire]
PORTAINER_ADMIN_PASSWORD=change_me_portainer_admin_password

# Tag de l'image portainer/portainer-ce (variante -alpine, requise par le healthcheck).
# [optionnel — défaut : 2.45.1-alpine]
#PORTAINER_VERSION=2.45.1-alpine

# Tag de l'image plantuml/plantuml-server.
# [optionnel — défaut : jetty-v1.2026.8]
#PLANTUML_VERSION=jetty-v1.2026.8

# --- Bootstrap temporaire (make bootstrap-legacy, ENV=local) -----------------

# Nom du projet GitLab de test créé par scripts/legacy/setup-gitlab.sh.
# [optionnel — défaut : factory-test]
#GITLAB_TEST_PROJECT_NAME=factory-test

# Clé du projet SonarQube de test créé par scripts/legacy/setup-sonarqube-analysis.sh.
# [optionnel — défaut : factory-test]
#SONARQUBE_TEST_PROJECT_KEY=factory-test
