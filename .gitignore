# Fichiers d'environnement (secrets) et leurs sauvegardes (make init FORCE=1) — seul l'exemple est versionné
envs/*.env
envs/*.env.*
!envs/.env.example

# Informations de connexion générées par le bootstrap
outputs/

# Certificats fournis (TLS_MODE=custom)
config/certs/*
!config/certs/.gitkeep
# CA facultative (config/certs/ca/ca.pem) : seul le répertoire est versionné
!config/certs/ca/
config/certs/ca/*
!config/certs/ca/.gitkeep

# Divers
*.log
.DS_Store
.idea/
.vscode/
